# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
# Local MongoDB
MONGO_URI=mongodb://localhost:27017/support_ticketing

# MongoDB Atlas (cloud) — use this instead of local:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/support_ticketing?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=supportdesk_super_secret_jwt_key_change_this_in_production_2025
JWT_EXPIRE=7d

# ── Google Gemini AI ─────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# If left blank, the system falls back to heuristic analysis (still works!)
GEMINI_API_KEY=your_gemini_api_key_here

# ── File Upload ──────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ── Frontend URL (for CORS) ──────────────────────────
# VS Code Live Server
FRONTEND_URL=http://127.0.0.1:5500

# If using Python http.server on port 5500:
# FRONTEND_URL=http://localhost:5500

# If using a deployed frontend:
# FRONTEND_URL=https://yourdomain.com